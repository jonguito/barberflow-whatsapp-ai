# Segredos ficam somente no servidor. Copie este arquivo para .env.
PORT=3000
BUSINESS_TIMEZONE=America/Sao_Paulo

# Senha obrigatória para qualquer ambiente exposto à internet.
# Com ADMIN_PASSWORD definida, o painel pede senha e o servidor escuta em 0.0.0.0.
ADMIN_PASSWORD=troque-por-uma-senha-longa-e-unica

# OpenAI Responses API. Sem chave, o app roda em modo demonstração com respostas de fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Escolha o conector de WhatsApp: meta, twilio ou evolution.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Business Platform / Cloud API oficial.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-aleatorio
META_APP_SECRET=

# Opcional: template Utility aprovado na Meta, com 4 variáveis de texto no corpo.
# {{1}} nome · {{2}} serviço · {{3}} data/hora · {{4}} barbeiro.
# Lembretes só são enviados a clientes que marcaram o opt-in.
WHATSAPP_CONFIRMATION_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Twilio WhatsApp. TWILIO_WEBHOOK_URL deve ser a URL pública exata cadastrada no Console.
# Ex.: From=whatsapp:+14155238886 no Sandbox, ou seu remetente WhatsApp aprovado.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://SEU-DOMINIO/webhooks/twilio
# Content SID (HX...) de templates WhatsApp aprovados no Twilio Content Template Builder.
TWILIO_CONFIRMATION_CONTENT_SID=
TWILIO_REMINDER_CONTENT_SID=

# Evolution API v2: URL base, chave da API e nome da instância.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Cadastre este mesmo valor como header x-barberflow-secret no webhook da instância.
EVOLUTION_WEBHOOK_SECRET=
